# Copy to .env and fill in only what you use. Everything is optional: with no
# keys at all, the bundle drafts and you post by hand.
#
# NOTE: the arming flag INSTAGRAM_STACK_ALLOW_PUBLISH is NOT read from this
# file, by design. A repository that arrives with a clone must not be able to
# arm itself. Set it in the shell you launch the agent from:
#
#     export INSTAGRAM_STACK_ALLOW_PUBLISH=1

# --- publishing (optional) ---------------------------------------------------
PUBLORA_API_KEY=
INSTAGRAM_PLATFORM_ID=

# --- reading your niche (optional) -------------------------------------------
APIFY_TOKEN=

# --- generating illustrations (optional) -------------------------------------
PIXFARO_TOKEN=
